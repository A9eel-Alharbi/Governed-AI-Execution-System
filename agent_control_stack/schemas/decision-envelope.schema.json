{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Control Stack Decision Envelope",
  "type": "object",
  "required": [
    "raw_input",
    "restored_input",
    "normalized_input",
    "outcome",
    "rationale",
    "restoration_trace",
    "balancing_trace",
    "decision_trace"
  ],
  "properties": {
    "raw_input": { "type": "string" },
    "restored_input": { "type": "string" },
    "normalized_input": { "type": "string" },
    "outcome": { "enum": ["clarify", "refuse", "dispatch", "escalate"] },
    "case_id": { "type": "string" },
    "rationale": { "type": "string" },
    "clarification_question": { "type": "string" },
    "refusal_reason": { "type": "string" },
    "escalation_reason": { "type": "string" },
    "restoration_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "replacement", "reason"],
        "properties": {
          "source": { "type": "string" },
          "replacement": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "balancing_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "properties": {
          "kind": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "decision_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "detail"],
        "properties": {
          "stage": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "dispatch_target": {
      "type": "object",
      "required": ["case_id", "procedure", "target", "human_review_gate"],
      "properties": {
        "case_id": { "type": "string" },
        "procedure": { "type": "string" },
        "target": { "type": "string" },
        "human_review_gate": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
