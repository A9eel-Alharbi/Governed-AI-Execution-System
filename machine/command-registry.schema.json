{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS/CDD v2 Command Registry",
  "type": "object",
  "required": ["spec_version", "owner", "last_validated", "commands"],
  "properties": {
    "spec_version": { "type": "string" },
    "owner": { "type": "string" },
    "last_validated": { "type": "string", "format": "date" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "maps_to",
          "target",
          "preconditions",
          "expected_agent_behavior",
          "expected_output_format",
          "human_review_gate"
        ],
        "properties": {
          "command": { "type": "string" },
          "maps_to": { "type": "string" },
          "target": { "type": "string" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "expected_agent_behavior": { "type": "array", "items": { "type": "string" } },
          "expected_output_format": { "type": "string" },
          "human_review_gate": { "type": "boolean" }
        }
      }
    },
    "change_log": { "type": "array" }
  },
  "additionalProperties": false
}
